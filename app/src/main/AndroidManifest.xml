<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <permission
        android:name="io.github.takattowo.usercabridge.permission.WRITE_REPORT"
        android:protectionLevel="signature" />
    <application
        android:name=".UserCABridgeApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:supportsRtl="true">
        <activity
            android:name=".StatusActivity"
            android:exported="true"
            android:label="@string/status_title"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <provider
            android:name=".TrustReportProvider"
            android:authorities="${applicationId}.trustreports"
            android:exported="true"
            android:grantUriPermissions="true"
            android:writePermission="io.github.takattowo.usercabridge.permission.WRITE_REPORT"
            tools:ignore="ExportedContentProvider" />
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:permission="android.permission.INTERACT_ACROSS_USERS"
            tools:replace="android:permission" />
    </application>
</manifest>
